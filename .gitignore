# Dataset and derived artefacts: never committed, they are regenerated by scripts.
/data/
/cache/
/checkpoints/
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Results: the JSON/CSV/PNG under results/ ARE committed (they are the evidence
# of real runs), but scratch and log files are not.
results/**/*.log
logs/

# OS / editor
.DS_Store
.idea/
.vscode/

# Large result artefacts (model weights, per-sample dumps); small CSV/JSON/PNG stay tracked
results/**/*.pt
results/**/*.pth
results/**/*.npy
results/**/*.npz

# Course source documents stay local (the interim .docx contains the fabricated results table)
DL_Interim_Report*.docx
DL_Synopsis*.pdf
ICT_4442_Mini_Project_Guidelines.pdf
.venv-post/
